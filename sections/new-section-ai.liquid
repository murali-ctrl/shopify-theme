{% liquid
  assign section_id = 'new-section-ai-' | append: section.id
  assign has_bg = section.settings.background_image != blank
%}

<section id="{{ section_id }}" class="new-section-ai color-{{ section.settings.color_scheme }}">
  {% if has_bg %}
    <div class="new-section-ai__bg">
      <img
        src="{{ section.settings.background_image | image_url: width: 2200 }}"
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="lazy"
      >
      <div class="new-section-ai__overlay"></div>
    </div>
  {% endif %}

  <div class="new-section-ai__inner">
    <div class="new-section-ai__content">
      {% if section.settings.eyebrow != blank %}
        <p class="new-section-ai__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="new-section-ai__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="new-section-ai__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="new-section-ai__button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="new-section-ai__features">
        {% for block in section.blocks %}
          <div class="new-section-ai__feature" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <img
                src="{{ block.settings.icon | image_url: width: 120 }}"
                alt="{{ block.settings.icon.alt | escape }}"
                class="new-section-ai__icon"
                loading="lazy"
              >
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="new-section-ai__feature-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="new-section-ai__feature-text">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #{{ section_id }} {
    --pad-top: {{ section.settings.padding_top_desktop }}px;
    --pad-bottom: {{ section.settings.padding_bottom_desktop }}px;
    padding-top: var(--pad-top);
    padding-bottom: var(--pad-bottom);
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .new-section-ai__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #{{ section_id }} .new-section-ai__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ section_id }} .new-section-ai__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }

  #{{ section_id }} .new-section-ai__inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding-left: 16px;
    padding-right: 16px;
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
  }

  #{{ section_id }} .new-section-ai__content {
    text-align: {{ section.settings.text_align }};
  }

  #{{ section_id }} .new-section-ai__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 12px;
    margin: 0 0 12px;
    opacity: 0.8;
  }

  #{{ section_id }} .new-section-ai__heading {
    font-size: clamp(28px, 4vw, 44px);
    margin: 0 0 12px;
  }

  #{{ section_id }} .new-section-ai__text {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 20px;
  }

  #{{ section_id }} .new-section-ai__button {
    display: inline-block;
    padding: 12px 20px;
    border: 1px solid currentColor;
    text-decoration: none;
  }

  #{{ section_id }} .new-section-ai__features {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  #{{ section_id }} .new-section-ai__feature {
    border: 1px solid currentColor;
    padding: 16px;
    background: rgba(255, 255, 255, 0.04);
  }

  #{{ section_id }} .new-section-ai__icon {
    width: 48px;
    height: 48px;
    object-fit: contain;
    display: block;
    margin-bottom: 12px;
  }

  #{{ section_id }} .new-section-ai__feature-title {
    margin: 0 0 8px;
    font-size: 18px;
  }

  #{{ section_id }} .new-section-ai__feature-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    #{{ section_id }} .new-section-ai__inner {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }
  }

  @media (max-width: 749px) {
    #{{ section_id }} {
      --pad-top: {{ section.settings.padding_top_mobile }}px;
      --pad-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #{{ section_id }} .new-section-ai__content {
      text-align: left;
    }
  }
</style>

{% schema %}
{
  "name": "New Section AI",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New Arrival"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for modern storefronts"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your story, highlight your value, and make it easy to act.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Short supporting text for this feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Section AI",
      "category": "Custom",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
